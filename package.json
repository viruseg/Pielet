{
  "name": "pielet",
  "version": "0.1.0",
  "description": "Small dependency-free ESM library for pie (radial) menus in the browser",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/pielet.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pielet.js"
    },
    "./style.css": "./dist/pielet.css"
  },
  "scripts": {
    "dev:demo": "vite",
    "build": "vite build && tsc -p tsconfig.dts.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "pie-menu",
    "radial-menu",
    "context-menu",
    "menu",
    "ui"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}